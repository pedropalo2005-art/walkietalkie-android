<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/dialog_bg"
    android:padding="20dp">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📻 CANALES DE RADIO"
            android:textColor="@color/radio_lcd_text"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/tvChannelCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="3 canales"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />
    </RelativeLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Selecciona una frecuencia o crea un canal privado"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <!-- Search Box -->
    <EditText
        android:id="@+id/etSearchChannel"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:background="@color/input_bg"
        android:hint="🔍 Buscar canal por nombre o frecuencia..."
        android:textColorHint="@color/text_muted"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:paddingHorizontal="12dp"
        android:maxLines="1"
        android:inputType="text" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="10dp"
        android:background="@color/radio_metal" />

    <!-- Channels Scroll List -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/llChannelItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="10dp"
        android:background="@color/radio_metal" />

    <!-- Bottom Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModalCreateChannel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="➕ CREAR CANAL"
            android:textColor="@color/white"
            app:backgroundTint="@color/ptt_active_base" />

        <Space
            android:layout_width="12dp"
            android:layout_height="wrap_content" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseChannelList"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cerrar"
            android:textColor="@color/text_muted"
            app:backgroundTint="@color/radio_metal" />
    </LinearLayout>

</LinearLayout>
