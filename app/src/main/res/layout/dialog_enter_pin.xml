<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/dialog_bg"
    android:padding="20dp">

    <!-- Header -->
    <TextView
        android:id="@+id/tvPinDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔒 CANAL PRIVADO"
        android:textColor="@color/badge_private"
        android:textSize="18sp"
        android:textStyle="bold"
        android:letterSpacing="0.1" />

    <TextView
        android:id="@+id/tvPinDialogSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Introduce el PIN de 4 dígitos asignado por el creador:"
        android:textColor="@color/text_muted"
        android:textSize="13sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="12dp"
        android:background="@color/radio_metal" />

    <!-- PIN input centered -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <EditText
            android:id="@+id/etPinEntry"
            android:layout_width="180dp"
            android:layout_height="60dp"
            android:background="@color/input_bg"
            android:hint="••••"
            android:textColorHint="@color/text_muted"
            android:textColor="@color/badge_private"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:letterSpacing="0.5"
            android:inputType="numberPassword"
            android:maxLength="4" />

        <TextView
            android:id="@+id/tvPinError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="❌ PIN incorrecto. Inténtalo de nuevo."
            android:textColor="@color/led_tx_active"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:gravity="end">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelPin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancelar"
            android:textColor="@color/text_muted"
            app:backgroundTint="@color/radio_metal" />

        <Space
            android:layout_width="12dp"
            android:layout_height="wrap_content" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmPin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Desbloquear"
            android:textColor="@color/white"
            app:backgroundTint="@color/badge_private" />
    </LinearLayout>

</LinearLayout>
